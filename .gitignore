# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ── Bundled binaries ─────────────────────────────────────────────────────
# ffmpeg.exe is ~147 MB and exceeds GitHub's 100 MB per-file limit.
# It does not belong in the repo anyway: every platform brings its own, and
# a checked-in Windows binary would be useless on Linux and macOS.
# See the README for how to install it.
ffmpeg.exe
ffprobe.exe
ffmpeg
ffprobe
*.exe
*.dll

# ── Analysis results and intermediate files ──────────────────────────────
*.fpsdata
*_fps_analysis.mp4
*_fps_analysis.mkv
output/
exports/

# ── Local settings ───────────────────────────────────────────────────────
# The actual user settings live under ~/.fps_analyzer/, i.e. outside the
# project. These entries only catch local copies.
settings.json
*.local.json

# ── Large media ──────────────────────────────────────────────────────────
*.mp4
*.mkv
*.mov
*.avi

# ── Tools and editors ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
